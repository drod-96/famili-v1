# Raccordement à Supabase. Copier en `.env.local` et remplir.
# Sans ces deux valeurs, l'application tourne sur le stockage local et le
# paquet scellé : pratique pour développer sans compte Supabase.
#
# Les deux se trouvent dans Project Settings → API.
# La clé « anon » est publique par conception : ce sont les règles RLS qui
# protègent les données, pas le fait de la cacher.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
